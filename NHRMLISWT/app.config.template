<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!-- 
    NHRMLISWT Configuration Template
    
    Environment Variables to Set:
    - NHRM_SERVICE_BASE_URL: Base URL for NHRMBase service
    - RFID_READER_IP: IP address of RFID reader
    - LOG_DIR: Directory for application logs
  -->
  
  <startup> 
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_INHRMBase">
          <security mode="Transport" />
        </binding>
      </basicHttpBinding>
    </bindings>
    <client>
      <!-- UPDATE THIS WITH YOUR SERVER ADDRESS -->
      <!-- Set NHRM_SERVICE_BASE_URL environment variable instead -->
      <endpoint address="https://10.10.10.24/nhrmbase/NHRMBase.svc"
          binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_INHRMBase"
          contract="NHRMBase.INHRMBase" name="BasicHttpBinding_INHRMBase" />
    </client>
  </system.serviceModel>
  
  <appSettings>
    <!-- substring for written list processing -->
    <add key="substringValue" value="4" />
    
    <!-- Log directory - set via LOG_DIR environment variable -->
    <add key="LogDirectory" value="C:\logs\NSBM\NHRMLISWT" />
  </appSettings>
</configuration>
