# Development Environment Configuration
# 
# Instructions:
# 1. Copy this file to .env
# 2. Update values for your environment
# 3. Add .env to .gitignore (already done)
# 4. Load before running applications
#
# On Windows CMD:
#   for /f "delims== tokens=1,2" %A in (.env) do set %A=%B
#
# On Windows PowerShell:
#   Get-Content .env | ForEach-Object { if ($_ -notmatch '^#' -and $_ -match '=') { $name, $value = $_ -split '='; [Environment]::SetEnvironmentVariable($name, $value) } }
#
# On Linux/Mac bash:
#   export $(cat .env | grep -v '^#' | xargs)

# Service Endpoints
NHRM_SERVICE_BASE_URL=https://10.10.10.24/nhrmbase
NHRM_PAYMENT_SERVICE_URL=https://10.10.10.24/nhrmbase/NHRMPayment.svc
NHRM_BASE_SERVICE_URL=https://10.10.10.24/nhrmbase/NHRMBase.svc
NHRM_UTILS_SERVICE_URL=https://10.10.10.24/nhrmbase/NHRMUtils.svc

# RFID Reader Configuration
RFID_READER_IP=127.0.0.1
RFID_READER_PORT=3050

# Logging
LOG_DIR=C:\logs\NSBM
LOG_LEVEL=Info

# Database (if applicable)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nhrmlis
DB_USER=admin
DB_PASSWORD=
