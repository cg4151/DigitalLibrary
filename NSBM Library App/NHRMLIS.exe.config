<?xml version="1.0" encoding="utf-8" ?>
<configuration>
 
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="NHRMLIS.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
      
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_INHRMPayment">
                    <security mode="Transport" />
                </binding>
                <binding name="BasicHttpBinding_INHRMBase">
                    <security mode="Transport" />
                </binding>
                <binding name="BasicHttpBinding_INHRMUtils">
                    <security mode="Transport" />
                </binding>
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="https://10.10.10.24/nhrmbase/NHRMPayment.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_INHRMPayment"
                contract="NHRMPayment.INHRMPayment" name="BasicHttpBinding_INHRMPayment" />
            <endpoint address="https:/10.10.10.24/nhrmbase/NHRMBase.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_INHRMBase"
                contract="NHRMBase.INHRMBase" name="BasicHttpBinding_INHRMBase" />
            <endpoint address="https://10.10.10.24/nhrmbase/NHRMUtils.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_INHRMUtils"
                contract="NHRMUtils.INHRMUtils" name="BasicHttpBinding_INHRMUtils" />
        </client>
    </system.serviceModel>
    <userSettings>
        <NHRMLIS.Properties.Settings>
            <setting name="checkbox" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="username" serializeAs="String">
                <value />
            </setting>
            <setting name="password" serializeAs="String">
                <value />
            </setting>
        </NHRMLIS.Properties.Settings>
    </userSettings>
  <runtime>
    <NetFx40_LegacySecurityPolicy enabled="true"/>
  </runtime>
</configuration>